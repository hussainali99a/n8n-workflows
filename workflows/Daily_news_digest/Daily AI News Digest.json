        "options": {}
      },
      "id": "c99835d9-fd87-4489-afa7-3430076ddebc",
      "name": "AI News Sources",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        272,
        128
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "feeds",
        "options": {}
      },
      "id": "cc8ed941-126f-44ea-ad60-9ae45dff2cc4",
      "name": "Split Out Feeds",

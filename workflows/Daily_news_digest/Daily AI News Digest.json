      "position": [
        496,
        128
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {}
      },
      "id": "a356a552-54af-4f89-b68c-10e2dc99efe4",
      "name": "Search AI News",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "position": [
        720,
        128
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "title",
              "type": "string",
              "value": "={{ $json.title }}"
            },
            {
              "id": "a2",
              "name": "link",
              "type": "string",
              "value": "={{ $json.link }}"
            },
            {
              "id": "a3",
              "name": "source",
              "type": "string",
              "value": "={{ $('Split Out Feeds').item.json.name }}"
            },
            {
              "id": "a4",
              "name": "published_at",
              "type": "string",
              "value": "={{ $json.isoDate || $json.pubDate || \"\" }}"
            },
            {
              "id": "a5",
              "name": "summary",
              "type": "string",
              "value": "={{ ($json.contentSnippet || \"\").replace(/\\s+/g, \" \").slice(0, 300) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "c949e577-de06-43dc-847f-83c02e95c530",
      "name": "Format Story",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        944,
        128
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.link }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.published_at ? new Date($json.published_at).getTime() : Date.now() }}",
              "rightValue": "={{ $now.minus({ hours: 36 }).toMillis() }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3e9494e3-3436-4e49-9ddd-2e0e9b25e04c",
